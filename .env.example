# .env.example
# -------------------------------------------------
# DARA Studio – environment configuration template
# -------------------------------------------------

# Supabase configuration (backend)
SUPABASE_URL="https://<YOUR-PROJECT>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<YOUR-SERVICE-ROLE-KEY>"

# Supabase configuration (frontend – Vite exposes variables prefixed with VITE_)
VITE_SUPABASE_URL="https://<YOUR-PROJECT>.supabase.co"
VITE_SUPABASE_ANON_KEY="<YOUR-ANON-KEY>"

# Gmail / email configuration (for notifications)
GMAIL_USER="your.email@example.com"
GMAIL_APP_PASSWORD="<APP-PASSWORD>"

# Frontend URL (used in email templates, redirects, etc.)
FRONTEND_URL="http://localhost:5173"

# Server configuration (optional)
PORT=5001

# Other optional variables
# NODE_ENV=development
# LOG_LEVEL=info

# Verified that all env vars referenced in code are present
