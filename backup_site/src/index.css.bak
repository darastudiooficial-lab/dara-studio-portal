/* ═══════════════════════════════════════════════════════════════
   DARA Studio — Pure CSS Design System (Executive Glass)
   ═══════════════════════════════════════════════════════════════ */

@import url('https://fonts.googleapis.com/css2?family=Inter:wght@200;300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600;1,700&family=Plus+Jakarta+Sans:wght@200;300;400;500;600;700&display=swap');

:root {
  --font-serif: 'Playfair Display', Georgia, serif;
  --font-sans: 'Inter', 'Plus Jakarta Sans', system-ui, sans-serif;
}

/* ── Reset ── */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html, body {
  background: #020203 radial-gradient(circle at 80% 80%, rgba(30, 58, 138, 0.1), transparent 40%);
  color: #F8FAFC;
  font-family: var(--font-sans);
  height: 100vh;
  margin: 0;
  overflow: hidden;
}

button, input, textarea {
  font-family: inherit;
}

a {
  text-decoration: none;
  color: inherit;
}

ul, ol {
  list-style: none;
}

/* ── Layout Single-View ── */
.landing-wrapper {
  position: relative;
  height: 100vh;
  width: 100vw;
  background: #020203;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.header-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24px 48px;
  z-index: 50;
  flex-shrink: 0;
}

/* ── Header Logo ── */
.header-logo {
  display: flex;
  align-items: center;
  gap: 12px;
  cursor: pointer;
  flex-shrink: 0;
  text-decoration: none;
  color: inherit;
}

.header-logo-icon {
  width: 42px;
  height: 42px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  filter: drop-shadow(0 0 12px rgba(139, 92, 246, 0.4));
  transition: filter 0.3s, transform 0.3s;
}
.header-logo:hover .header-logo-icon {
  filter: drop-shadow(0 0 20px rgba(139, 92, 246, 0.65));
  transform: scale(1.06);
}

.header-logo-text {
  color: #fff;
  font-size: 22px;
  letter-spacing: -0.02em;
  font-family: var(--font-sans);
  display: flex;
  align-items: baseline;
  gap: 5px;
}
.header-logo-text strong {
  font-weight: 700;
  letter-spacing: -0.02em;
}
.header-logo-text em {
  font-style: italic;
  font-weight: 300;
  font-family: var(--font-serif);
  opacity: 0.85;
}

/* ── Center Nav Container ── */
.header-center-nav {
  display: flex;
  align-items: center;
  gap: 8px;
}

/* ── Glass Nav Link (each menu item) ── */
.glass-nav-link,
a.glass-nav-link {
  border-radius: 9999px;
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-top: 1px solid rgba(255, 255, 255, 0.15);
  color: #94a3b8;
  font-family: var(--font-sans);
  font-size: 13px;
  font-weight: 500;
  padding: 8px 20px;
  cursor: pointer;
  transition: all 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  text-decoration: none;
  display: inline-flex;
  align-items: center;
}

.glass-nav-link:hover,
a.glass-nav-link:hover {
  color: #fff;
  background: rgba(139, 92, 246, 0.12);
  border-color: rgba(139, 92, 246, 0.25);
  border-top-color: rgba(255, 255, 255, 0.25);
  box-shadow: 0 0 18px rgba(139, 92, 246, 0.25),
              inset 0 1px 0 rgba(255, 255, 255, 0.1);
  transform: translateY(-1px);
}

/* ── Header CTA Button ── */
.header-cta,
a.header-cta {
  background: linear-gradient(135deg, #8B5CF6, #D946EF) !important;
  border: 1px solid transparent !important;
  border-top: 1px solid rgba(255, 255, 255, 0.3) !important;
  border-left: 1px solid rgba(255, 255, 255, 0.1) !important;
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  box-shadow: 0 0 20px rgba(139, 92, 246, 0.5);
  padding: 10px 24px !important;
  font-size: 13px !important;
  font-weight: 700;
  font-family: 'Inter', var(--font-sans);
  flex-shrink: 0;
  transition: all 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  text-decoration: none;
  color: #fff;
  display: inline-flex;
  align-items: center;
}

.header-cta:hover,
a.gradient-text {
  background-image: linear-gradient(135deg, #8B5CF6, #D946EF) !important;
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  filter: drop-shadow(0 0 6px rgba(168, 85, 247, 0.4));
}

.badge-gradient {
  background-image: linear-gradient(135deg, #8B5CF6, #D946EF) !important;
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  filter: drop-shadow(0 0 4px rgba(168, 85, 247, 0.3));
}

.header-cta:hover,
a.header-cta:hover {
  background: linear-gradient(135deg, #8B5CF6, #D946EF) !important;
  transform: scale(1.05);
  box-shadow: 0 0 20px rgba(168, 85, 247, 0.4);
  filter: brightness(1.2);
  border-top-color: rgba(255, 255, 255, 0.5) !important;
}

.hero-section {
  position: relative;
  z-index: 10;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  gap: 36px;
  padding: 0 24px;
}

.footer-services {
  flex-shrink: 0;
  width: 100%;
  padding: 18px 24px 0;
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  gap: 12px; /* fixed gap-12 */
  border-top: 1px solid rgba(255, 255, 255, 0.05);
  background: transparent;
  z-index: 10;
}

/* ── Footer Authority Row ── */
.footer-authority-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14px;
  flex-wrap: wrap;
}

.footer-authority-item {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-family: var(--font-sans);
  font-size: 10px;
  font-weight: 400;
  letter-spacing: 0.06em;
  color: #475569; /* slate-600 */
  opacity: 0.5; /* default 50% */
  transition: color 0.2s, opacity 0.2s;
}
.footer-authority-item:hover {
  opacity: 1; /* full opacity on hover */
}

.footer-authority-item:hover {
  color: #94a3b8; /* slate-400 */
}

.footer-authority-dot {
  color: rgba(255, 255, 255, 0.1);
  font-size: 12px;
}

/* ── Footer Contact Bar (Glassmorphism) ── */
.footer-contact-bar {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 48px;
  border-top: 1px solid rgba(255, 255, 255, 0.04);
  background: rgba(255, 255, 255, 0.02);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  margin-top: 4px;
  position: relative;
}

/* Social icons */
.footer-social {
  display: flex;
  align-items: center;
  gap: 14px;
}

.footer-social-link {
  display: flex;
  align-items: center;
  color: #475569;
  opacity: 0.5; /* 50% default */
  transition: color 0.2s, opacity 0.2s, transform 0.2s;
  text-decoration: none;
}

.footer-social-link:hover {
  color: #ffffff;
  opacity: 1;
  transform: translateY(-1px);
}

/* Center copyright */
  .footer-copy {
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 300;
    color: #334155;
    letter-spacing: 0.05em;
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    opacity: 0.5;
    transition: opacity 0.2s;
  }
  .footer-copy:hover {
    opacity: 1;
  }

/* Contact link */
  .footer-contact-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 300;
    color: #475569;
    letter-spacing: 0.05em;
    text-decoration: none;
    opacity: 0.5; /* 50% default */
    transition: color 0.2s, opacity 0.2s;
  }
  .footer-contact-link:hover {
    opacity: 1;
  }

.footer-contact-link:hover {
  color: #ffffff;
  opacity: 1;
}
/* ── Footer Wrapper & Service Item ── */
.footer-wrapper {
  display: flex;
  flex-direction: column;
  gap: 1rem; /* space-y-4 equivalent */
}
.footer-service-item {
  font-family: var(--font-sans);
  font-size: 0.75rem; /* text-xs */
  font-weight: 600;
  letter-spacing: 0.1em;
  color: #94a3b8; /* slate-400 for subtle text */
  opacity: 0.5;
  transition: opacity 0.2s, color 0.2s;
}
.footer-service-item:hover {
  opacity: 1;
  color: #fff;
}
/* ── Background Glow ── */
.radial-glow {
  position: absolute;
  top: -30%;
  left: 50%;
  transform: translateX(-50%);
  width: 1000px;
  height: 800px;
  background: rgba(168, 85, 247, 0.15);
  border-radius: 50%;
  filter: blur(140px);
  pointer-events: none;
  z-index: 0;
}

.radial-glow-navy {
  position: absolute;
  bottom: -20%;
  right: -10%;
  width: 800px;
  height: 800px;
  background: rgba(15, 23, 42, 0.6);
  border-radius: 50%;
  filter: blur(140px);
  pointer-events: none;
  z-index: 0;
}

/* ── Executive Glass Classes ── */
.glass-pill {
  border-radius: 9999px;
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255,255,255,0.05);
  border-top: 1px solid rgba(255, 255, 255, 0.3);
  border-left: 1px solid rgba(255, 255, 255, 0.1);
  background: rgba(255,255,255,0.05);
  color: #fff;
  font-size: 15px;
  font-weight: 700;
  padding: 14px 32px;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  transition: all 0.3s ease;
}

.glass-pill:hover {
  background: rgba(255, 255, 255, 0.1);
  transform: scale(1.05);
  box-shadow: 0 0 20px rgba(168, 85, 247, 0.4);
  filter: brightness(1.2);
  border-top-color: rgba(255, 255, 255, 0.5);
}

.btn-glow {
  border-radius: 9999px;
  background: linear-gradient(135deg, #8B5CF6, #EC4899);
  box-shadow: 0 0 20px rgba(139, 92, 246, 0.5);
  border: 1px solid transparent;
  border-top: 1px solid rgba(255, 255, 255, 0.3);
  border-left: 1px solid rgba(255, 255, 255, 0.1);
  color: #fff;
  font-size: 15px;
  font-weight: 700;
  padding: 14px 32px;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  transition: all 0.3s ease;
}

.btn-glow:hover {
  transform: scale(1.05);
  box-shadow: 0 0 25px rgba(168, 85, 247, 0.6);
  filter: brightness(1.2);
  border-top-color: rgba(255, 255, 255, 0.5);
}

/* ── Specific Components ── */
.badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 24px;
  border-radius: 9999px;
  border: 1px solid rgba(255, 255, 255, 0.1);
  background: rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
}

.badge-icon {
  color: #818cf8;
  font-size: 12px;
}

.badge-text {
  color: #a5b4fc;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.2em;
  text-transform: uppercase;
}

.hero-heading {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.heading-normal {
  font-family: var(--font-serif);
  font-size: clamp(52px, 8vw, 80px);
  line-height: 1.05;
  color: #ffffff;
  font-weight: 400;
  letter-spacing: -0.04em;
}

.heading-italic {
  font-family: var(--font-serif);
  font-style: italic;
  font-size: clamp(52px, 8vw, 80px);
  line-height: 1.05;
  color: #a5b4fc;
  font-weight: 400;
  letter-spacing: -0.04em;
  margin-top: -8px;
}

.hero-subtitle {
  color: #94a3b8;
  font-size: 17px;
  line-height: 1.6;
  max-width: 600px;
  font-weight: 200;
}

.action-buttons {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16px;
}

.trust-indicators {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 40px;
  font-size: 13px;
  color: #64748b;
  font-weight: 500;
  margin-top: 24px;
}

.trust-item {
  display: flex;
  align-items: center;
  gap: 8px;
}

.footer-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 16px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.15em;
  color: #475569;
  text-transform: uppercase;
}

.footer-row span {
  cursor: pointer;
  transition: color 0.2s;
}

.footer-row span:hover {
  color: #94a3b8;
}

.footer-divider {
  color: rgba(255, 255, 255, 0.2); /* 20% opacity */
  font-weight: 300;
}

/* ── Typography Utilities ── */
.font-serif { font-family: var(--font-serif); }
.font-sans { font-family: var(--font-sans); }
.italic { font-style: italic; }

/* ── Animations ── */
@keyframes sophisticatedReveal {
  0% { 
    opacity: 0; 
    transform: translateY(10px); 
    backdrop-filter: blur(0px);
    -webkit-backdrop-filter: blur(0px);
  }
  100% { 
    opacity: 1; 
    transform: translateY(0); 
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }
}

.animate-float-up {
  animation: sophisticatedReveal 1.2s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  opacity: 0;
}

.delay-100 { animation-delay: 100ms; }
.delay-200 { animation-delay: 200ms; }
.delay-300 { animation-delay: 300ms; }
.delay-400 { animation-delay: 400ms; }
.delay-500 { animation-delay: 500ms; }

/* ── Custom Cursor ── */
.glass-cursor {
  position: fixed;
  top: 0; left: 0;
  width: 32px; height: 32px;
  border-radius: 50%;
  border: 1px solid rgba(255, 255, 255, 0.2);
  background: rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
  pointer-events: none;
  transform: translate(-50%, -50%);
  z-index: 9999;
  transition: width 0.2s, height 0.2s, background 0.2s;
  mix-blend-mode: difference;
}
.glass-cursor.hovering {
  width: 64px; height: 64px;
  background: rgba(255, 255, 255, 0.1);
}

.compliance-badge {
  position: absolute;
  bottom: 24px;
  right: 24px;
  font-size: 10px;
  font-weight: 600;
  color: #475569;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  display: flex;
  align-items: center;
  gap: 8px;
  z-index: 50;
  opacity: 0.6;
  transition: opacity 0.3s;
}
.compliance-badge:hover {
  opacity: 1;
}
